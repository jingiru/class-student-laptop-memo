{
  "name": "classroom-guide-mvp",
  "version": "0.1.0",
  "private": true,
  "author": "Classroom Guide",
  "description": "교사 노트북을 로컬 서버로 사용하는 Classroom Guide MVP",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:teacher": "npm run start --workspace @classroom-guide/teacher-server",
    "start:teacher-app": "npm run start --workspace @classroom-guide/teacher-electron",
    "start:student": "npm run start --workspace @classroom-guide/student-electron",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check --workspace @classroom-guide/teacher-server && npm run check --workspace @classroom-guide/teacher-electron && npm run check --workspace @classroom-guide/student-electron",
    "dist:student": "electron-builder --config build/student-builder.yml --win nsis --x64",
    "dist:teacher": "electron-builder --config build/teacher-builder.yml --win nsis --x64",
    "dist:windows": "npm run dist:student && npm run dist:teacher"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.0.20"
  }
}
